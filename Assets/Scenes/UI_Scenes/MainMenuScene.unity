  m_text: '<color=#FFD700>  [ A / D ]</color><pos=350><color=#888888>:</color>  <pos=385><color=#FFFFFF>Move
    Left / Right</color>

    <color=#FFD700>  [ Shift + Move ]</color><pos=350><color=#888888>:</color> 
    <pos=385><color=#FFFFFF>Run</color>

    <color=#FFD700>  [ Space ]</color><pos=350><color=#888888>:</color> 
    <pos=385><color=#FFFFFF>Jump</color>

    <color=#FFD700>  [ J ]</color><pos=350><color=#888888>:</color> 
    <pos=385><color=#FFFFFF>Sword Attack (Combo x3)</color>

    <color=#FFD700> 
    [ K ]</color><pos=350><color=#888888>:</color>  <pos=385><color=#FFFFFF>Defend
    / Block</color>

    <color=#FFD700>  [ U ]</color><pos=350><color=#888888>:</color> 
    <pos=385><color=#FFFFFF>Throw Shuriken</color>

    <color=#FFD700>  [ C ]</color><pos=350><color=#888888>:</color> 
    <pos=385><color=#FFFFFF>Dash</color>

    <color=#FFD700>  [ 1 ]</color><pos=350><color=#888888>:</color> 
    <pos=385><color=#FFFFFF>Eat Apple (Heal HP)</color>

    <color=#FFD700>  [ E
    ]</color><pos=350><color=#888888>:</color>  <pos=385><color=#FFFFFF>Open Shop
    (Near NPC)</color>

    <color=#FFD700>  [ ESC ]</color><pos=350><color=#888888>:</color> 
